/** Ackrad & Kaluya wedding RSVP. Publish as an Apps Script web app.
 * Default RSVP deadline is 15 December 2026 at 23:59 Zambia time.
 * Change SCRIPT PROPERTY `RSVP_DEADLINE` to override this default.
 */
const CONFIG={CAPACITY:150,EVENT:'2027-01-02T10:00:00+02:00',TZ:'Africa/Lusaka',SHEET:'RSVP',FIELDS:['Timestamp','Confirmation','Title','First name','Surname','Side','Age','WhatsApp','City','Country','Accessibility','Assistance details','Status']};
function doGet(){return HtmlService.createHtmlOutputFromFile('Index').setTitle('Ackrad & Kaluya | Wedding RSVP').addMetaTag('viewport','width=device-width, initial-scale=1');}
function sheet_(){const prop=PropertiesService.getScriptProperties();let id=prop.getProperty('RSVP_SPREADSHEET_ID');if(!id){const s=SpreadsheetApp.create('Ackrad & Kaluya â Wedding RSVP (private)');id=s.getId();prop.setProperty('RSVP_SPREADSHEET_ID',id)}const ss=SpreadsheetApp.openById(id);let sh=ss.getSheetByName(CONFIG.SHEET);if(!sh){sh=ss.insertSheet(CONFIG.SHEET);sh.appendRow(CONFIG.FIELDS);sh.setFrozenRows(1)}return sh}
function rows_(sh){const n=sh.getLastRow();return n<2?[]:sh.getRange(2,1,n-1,CONFIG.FIELDS.length).getValues()}
function status_(rows){const confirmed=rows.filter(r=>String(r[12]).trim().toLowerCase()==='confirmed').length, remaining=Math.max(0,CONFIG.CAPACITY-confirmed);const deadline=PropertiesService.getScriptProperties().getProperty('RSVP_DEADLINE')||'2026-12-15T23:59:00+02:00';const deadlineTime=deadline?Date.parse(deadline):NaN;const validDeadline=Number.isFinite(deadlineTime);let reason='';if(!validDeadline)reason='Organizer setup is not complete: RSVP deadline not configured.';else if(Date.now()>deadlineTime)reason='The RSVP deadline has passed.';else if(Date.now()>=Date.parse(CONFIG.EVENT))reason='This event has already started.';else if(remaining===0)reason='All 150 places are confirmed.';const display=validDeadline?Utilities.formatDate(new Date(deadlineTime),CONFIG.TZ,'d MMMM yyyy, HH:mm'):'';return{capacity:CONFIG.CAPACITY,confirmed,remaining,open:!reason,reason,deadlineDisplay:display}}
function getPublicStatus(){return status_(rows_(sheet_()))}
function scrub_(s,max){return String(s||'').trim().slice(0,max).replace(/^[=+@\-]/,'\u2019$&')}
function registerGuest(g){const lock=LockService.getScriptLock();if(!lock.tryLock(25000))return{ok:false,message:'Registration is busy. Please retry shortly.'};try{const sh=sheet_(),rows=rows_(sh),status=status_(rows);if(!status.open)return{ok:false,message:status.reason};const allowedTitles=['Mr','Mrs','Miss','Ms','Dr','Prof','Rev','Other'];if(!allowedTitles.includes(g.title)||!['Groom','Bride'].includes(g.side))return{ok:false,message:'Please select your title and family side.'};const first=scrub_(g.firstName,70),last=scrub_(g.lastName,70),age=Number(g.age),phone=scrub_(g.whatsapp,32),city=scrub_(g.city,90),country=scrub_(g.country,90);if(!first||!last||!city||!country||!Number.isInteger(age)||age<18||age>120||!/^\+?[0-9\s()-]{8,22}$/.test(phone))return{ok:false,message:'Please check your age, full name, WhatsApp number, city and country.'};const phoneKey=phone.replace(/\D/g,'');if(rows.some(r=>String(r[7]).replace(/\D/g,'')===phoneKey&&String(r[12]).toLowerCase()==='confirmed'))return{ok:false,message:'This WhatsApp number is already registered. Please contact the organizer if you need help.'};const code='AK-'+Utilities.formatDate(new Date(),CONFIG.TZ,'yyMMdd')+'-'+Utilities.getUuid().slice(0,8).toUpperCase();sh.appendRow([new Date(),code,g.title,first,last,g.side,age,"'"+phone,city,country,g.accessibility==='Yes'?'Yes':'No',scrub_(g.assistanceDetails,350),'Confirmed']);return{ok:true,code,status:status_(rows_(sh))}}finally{lock.releaseLock()}}
/** ADMIN: Run this manually in script editor to display the private spreadsheet URL. */
function adminShowSheet(){Logger.log(SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty('RSVP_SPREADSHEET_ID')).getUrl())}
